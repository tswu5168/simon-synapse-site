---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { selectVisibleEntries } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  const visible = selectVisibleEntries(entries, {
    showDrafts: import.meta.env.PUBLIC_SHOW_DRAFTS === "true",
  });
  return visible.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.(md|mdx)$/, "");
const { Content } = await render(entry);
---

<ArticleLayout entry={entry} kind="project" pathname={`/projects/${slug}`}>
  <Content />
</ArticleLayout>
