---
import KakeyaLayout from "../../layouts/KakeyaLayout.astro";
---

<KakeyaLayout
  title="掛谷猜想 3D 沉浸藝術"
  description="以光線、深度與緩慢運動組成的三維沉浸畫面，從藝術視角感受掛谷集合容納所有方向的張力。"
  canonicalPath="/kakeya/immersive"
  activeMode="immersive"
>
  <article class="kakeya-page container">
    <header class="kakeya-hero">
      <div class="kakeya-hero__copy">
        <p class="kakeya-kicker">Immersive Art</p>
        <h1>把無數方向收進一道光</h1>
        <p>讓方向、密度與空間感形成一件可觀看、可停留的數學光雕。</p>
      </div>
      <div class="kakeya-stage" aria-label="沉浸藝術 3D 展示區"></div>
    </header>
  </article>
</KakeyaLayout>
