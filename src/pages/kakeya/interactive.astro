---
import KakeyaScene from "../../components/kakeya/KakeyaScene.astro";
import KakeyaLayout from "../../layouts/KakeyaLayout.astro";
---

<KakeyaLayout
  title="掛谷猜想 3D 互動科普"
  description="以可旋轉的三維示意與清楚控制項，直觀探索掛谷猜想中的方向、線段與體積概念。"
  canonicalPath="/kakeya/interactive"
  activeMode="interactive"
>
  <article class="kakeya-page">
    <header class="kakeya-hero container">
      <div class="kakeya-hero__copy">
        <p class="kakeya-kicker">Interactive Science</p>
        <h1>用手轉動每一個方向</h1>
        <p>
          拖曳畫面改變視角，再調整方向數、線段粗細與中心分散程度。你看到的是有限取樣模型，用來建立「每個方向都有一根單位線段」的空間直覺。
        </p>

        <section class="kakeya-panel" aria-labelledby="interactive-controls-title">
          <h2 id="interactive-controls-title">調整示意模型</h2>
          <div class="kakeya-control-grid">
            <div class="kakeya-control">
              <div class="kakeya-control__heading">
                <label for="direction-count">方向數</label>
                <output
                  for="direction-count"
                  id="direction-count-output"
                  data-testid="direction-count-output">192 根</output
                >
              </div>
              <input
                id="direction-count"
                type="range"
                min="32"
                max="512"
                step="32"
                value="192"
              />
            </div>

            <div class="kakeya-control">
              <div class="kakeya-control__heading">
                <label for="tube-radius">線段粗細</label>
                <output
                  for="tube-radius"
                  id="tube-radius-output"
                  data-testid="tube-radius-output">0.009</output
                >
              </div>
              <input
                id="tube-radius"
                type="range"
                min="0.003"
                max="0.025"
                step="0.001"
                value="0.009"
              />
            </div>

            <div class="kakeya-control">
              <div class="kakeya-control__heading">
                <label for="dispersion">中心分散程度</label>
                <output
                  for="dispersion"
                  id="dispersion-output"
                  data-testid="dispersion-output">24%</output
                >
              </div>
              <input
                id="dispersion"
                type="range"
                min="0"
                max="0.75"
                step="0.01"
                value="0.24"
              />
            </div>
          </div>

          <div class="kakeya-actions">
            <button id="toggle-motion" type="button" aria-pressed="true">
              暫停旋轉
            </button>
            <button id="reset-scene" type="button">重設模型</button>
          </div>
        </section>
      </div>

      <div class="kakeya-stage">
        <KakeyaScene label="掛谷猜想互動科普模型" mode="interactive" />
        <p class="kakeya-stage__hint">拖曳旋轉，滾輪或雙指縮放</p>
      </div>
    </header>

    <section class="container kakeya-explainer" aria-labelledby="interactive-explainer-title">
      <div>
        <p class="kakeya-kicker">What to notice</p>
        <h2 id="interactive-explainer-title">方向變多，不等於證明完成</h2>
      </div>
      <div class="kakeya-panel">
        <p>
          掛谷集合要求每一個方向都能找到一根長度為 1 的線段。畫面把每根線段做成有厚度的細管，才能在螢幕上看見；這個粗細可類比數學裡用來觀察集合的 δ 鄰域。
        </p>
        <p
          class="kakeya-disclaimer"
          data-testid="finite-sample-note"
        >
          模型限制：有限方向取樣不是數學證明；細管的可見體積也不等於理論集合本身的體積。
        </p>
      </div>
    </section>
  </article>
</KakeyaLayout>

<script>
  import { MODE_PRESETS } from "../../lib/kakeya/presets";
  import { mountKakeyaScene } from "../../lib/kakeya/scene";
  import type { KakeyaSceneController } from "../../lib/kakeya/types";

  const host = document.querySelector<HTMLElement>(
    '[data-kakeya-host][data-mode="interactive"]',
  );
  const directionCount = document.querySelector<HTMLInputElement>(
    "#direction-count",
  );
  const tubeRadius =
    document.querySelector<HTMLInputElement>("#tube-radius");
  const dispersion = document.querySelector<HTMLInputElement>("#dispersion");
  const directionOutput = document.querySelector<HTMLOutputElement>(
    "#direction-count-output",
  );
  const radiusOutput = document.querySelector<HTMLOutputElement>(
    "#tube-radius-output",
  );
  const dispersionOutput = document.querySelector<HTMLOutputElement>(
    "#dispersion-output",
  );
  const motionButton =
    document.querySelector<HTMLButtonElement>("#toggle-motion");
  const resetButton =
    document.querySelector<HTMLButtonElement>("#reset-scene");

  let scene: KakeyaSceneController | undefined;
  let paused = false;

  const showFallback = () => {
    if (!host) return;
    host.dataset.state = "error";
    host.querySelector<HTMLElement>("[data-kakeya-loading]")?.setAttribute(
      "hidden",
      "",
    );
    host.querySelector<HTMLElement>("[data-kakeya-error]")?.removeAttribute(
      "hidden",
    );
  };

  if (host) {
    try {
      scene = mountKakeyaScene(host, MODE_PRESETS.interactive);
    } catch {
      showFallback();
    }
  }

  const updateDirectionCount = () => {
    if (!directionCount || !directionOutput) return;
    const count = Number(directionCount.value);
    directionOutput.value = `${count} 根`;
    scene?.update({ count });
  };

  const updateTubeRadius = () => {
    if (!tubeRadius || !radiusOutput) return;
    const radius = Number(tubeRadius.value);
    radiusOutput.value = radius.toFixed(3);
    scene?.update({ tubeRadius: radius });
  };

  const updateDispersion = () => {
    if (!dispersion || !dispersionOutput) return;
    const value = Number(dispersion.value);
    dispersionOutput.value = `${Math.round(value * 100)}%`;
    scene?.update({ dispersion: value });
  };

  directionCount?.addEventListener("input", updateDirectionCount);
  tubeRadius?.addEventListener("input", updateTubeRadius);
  dispersion?.addEventListener("input", updateDispersion);

  motionButton?.addEventListener("click", () => {
    paused = !paused;
    scene?.setPaused(paused);
    motionButton.setAttribute("aria-pressed", String(!paused));
    motionButton.textContent = paused ? "繼續旋轉" : "暫停旋轉";
  });

  resetButton?.addEventListener("click", () => {
    if (!directionCount || !tubeRadius || !dispersion) return;
    directionCount.value = String(MODE_PRESETS.interactive.count);
    tubeRadius.value = String(MODE_PRESETS.interactive.tubeRadius);
    dispersion.value = String(MODE_PRESETS.interactive.dispersion);
    paused = false;
    motionButton?.setAttribute("aria-pressed", "true");
    if (motionButton) motionButton.textContent = "暫停旋轉";
    updateDirectionCount();
    updateTubeRadius();
    updateDispersion();
    scene?.setPaused(false);
  });

  window.addEventListener("pagehide", () => scene?.destroy(), { once: true });
</script>

<style>
  .kakeya-panel h2 {
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .kakeya-actions {
    margin-block-start: 1.25rem;
  }

  .kakeya-stage__hint {
    position: absolute;
    z-index: 4;
    inset: 1rem 1rem auto auto;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: var(--text-muted);
    background: rgb(5 8 22 / 72%);
    font-size: 0.78em;
    pointer-events: none;
  }

  .kakeya-explainer {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem clamp(3rem, 8vw, 7rem);
  }

  @media (min-width: 56rem) {
    .kakeya-explainer {
      grid-template-columns: minmax(16rem, 0.65fr) minmax(28rem, 1.35fr);
    }
  }
</style>
