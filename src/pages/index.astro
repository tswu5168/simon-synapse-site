---
import { getCollection } from "astro:content";
import HeroSignal from "../components/HeroSignal.astro";
import InsightCard from "../components/InsightCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { selectVisibleEntries, sortNewestFirst } from "../lib/content";
import { profileJsonLd } from "../lib/seo";

const showDrafts = import.meta.env.PUBLIC_SHOW_DRAFTS === "true";
const insights = sortNewestFirst(
  selectVisibleEntries(await getCollection("insights"), { showDrafts }),
);
const projects = sortNewestFirst(
  selectVisibleEntries(await getCollection("projects"), { showDrafts }),
);
const featuredInsights = insights.filter((entry) => entry.data.featured).slice(0, 2);
const latestInsights = insights
  .filter((entry) => !featuredInsights.some((featured) => featured.id === entry.id))
  .slice(0, 3);
const featuredProjects = projects.slice(0, 3);
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  canonicalPath="/"
  jsonLd={profileJsonLd()}
>
  <HeroSignal />

  <section class="content-section container" aria-labelledby="featured-heading">
    <div class="section-heading">
      <h2 id="featured-heading">焦點觀點</h2>
      <a href="/insights">瀏覽全部文章</a>
    </div>
    {
      featuredInsights.length > 0 ? (
        <div class="card-grid">
          {featuredInsights.map((entry) => <InsightCard entry={entry} />)}
        </div>
      ) : (
        <p class="empty-state">焦點文章正在進行人工編輯審查，通過後會在這裡發布。</p>
      )
    }
  </section>

  <section class="content-section container" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">最新訊號</h2>
    </div>
    {
      latestInsights.length > 0 ? (
        <div class="card-grid">
          {latestInsights.map((entry) => <InsightCard entry={entry} />)}
        </div>
      ) : (
        <p class="empty-state">最新文章尚在整理證據與來源，本站不以空泛內容填補版面。</p>
      )
    }
  </section>

  <section class="content-section container" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading">作品實證</h2>
      <a href="/projects">瀏覽全部作品</a>
    </div>
    {
      featuredProjects.length > 0 ? (
        <div class="card-grid">
          {featuredProjects.map((entry) => <ProjectCard entry={entry} />)}
        </div>
      ) : (
        <p class="empty-state">作品案例正在補齊方法、限制與可查證來源後再公開。</p>
      )
    }
  </section>

  <section class="content-section container split-panel" aria-labelledby="author-heading">
    <div>
      <p class="eyebrow">Human review required</p>
      <h2 id="author-heading">關於賽腦耶</h2>
    </div>
    <div>
      <p>
        賽腦耶以個人觀點提出問題，運用 AI 協助研究與實作，最後由本人查核、修訂與決定是否發布。
      </p>
      <a class="button" href="/about">了解創作方法</a>
    </div>
  </section>

  <section class="content-section container" aria-labelledby="topics-heading">
    <div class="section-heading">
      <h2 id="topics-heading">探索主題</h2>
    </div>
    <nav class="topic-links" aria-label="主題入口">
      <a href="/insights">AI 工具</a>
      <a href="/insights">資料研究</a>
      <a href="/insights">實作教學</a>
      <a href="/insights">數位資產</a>
      <a href="/projects">作品紀錄</a>
    </nav>
    <p class="site-disclaimer">{SITE.disclaimer}</p>
  </section>
</BaseLayout>

<style>
  .split-panel {
    display: grid;
    gap: 1.5rem;
    border-block: 1px solid var(--border);
  }

  .split-panel p {
    color: var(--text-muted);
  }

  .topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topic-links a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    color: var(--text);
    background: var(--surface-glass);
    text-decoration: none;
  }

  .site-disclaimer {
    max-width: var(--reading-width);
    margin-block-start: 2rem;
    color: var(--text-muted);
    font-size: 0.9em;
  }

  @media (min-width: 56rem) {
    .split-panel {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
  }
</style>
