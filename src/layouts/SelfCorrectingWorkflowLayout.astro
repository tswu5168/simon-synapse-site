---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { articleJsonLd } from "../lib/seo";
import { SITE } from "../config/site";

interface Props {
  entry: CollectionEntry<"insights">;
  pathname: string;
}

const { entry, pathname } = Astro.props;
const publishedLabel = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.publishedAt);
const jsonLd = articleJsonLd({
  title: entry.data.title,
  description: entry.data.seoDescription,
  pathname,
  publishedAt: entry.data.publishedAt,
  updatedAt: entry.data.updatedAt,
  image: entry.data.socialImage,
});
const starterPrompt = [
  "請完成這份成果，但不要以「寫完」作為完成標準。",
  "",
  "完成前請依序確認：",
  "1. 可檢查的條件是否都已通過。",
  "2. 發現問題時，只修正被指出的位置。",
  "3. 連續兩次卡在同一個問題時，停止並整理原因。",
  "4. 涉及公開、付款、刪除或對外聯絡時，保留給人類核准。",
  "",
  "最後請回報：已驗證項目、尚未確認項目、需要我判斷的事情。",
].join("\n");
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.seoDescription}
  canonicalPath={pathname}
  image={entry.data.socialImage}
  jsonLd={jsonLd}
  loadAds={false}
  bodyClass="workflow-light"
>
  <article class="workflow-page">
    <section class="workflow-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="signal-label">WORKFLOW NOTE · 01</p>
          <h1>AI 做得快，<br />為什麼交付還是卡在你？</h1>
          <p class="hero-lead">
            問題通常不在生成速度，而在最後那段反覆確認。把「再檢查一次」變成一套看得見的流程，才能讓 AI 幫上忙，而不是多了一位需要管理的實習生。
          </p>
          <div class="hero-actions">
            <a class="workflow-button primary" href="#control-room">看懂品質迴圈</a>
            <a class="workflow-button quiet" href="#starter-kit">帶走起手式</a>
          </div>
          <dl class="hero-facts">
            <div>
              <dt>適用情境</dt>
              <dd>文章、資料整理、程式修改</dd>
            </div>
            <div>
              <dt>保留給人</dt>
              <dd>高風險決策與最後放行</dd>
            </div>
          </dl>
        </div>

        <figure class="hero-console" aria-labelledby="hero-console-caption">
          <div class="console-topline">
            <span>QUALITY SIGNAL</span>
            <span class="live-dot">LIVE</span>
          </div>
          <div class="orbit-diagram" aria-hidden="true">
            <svg viewBox="0 0 520 520">
              <defs>
                <linearGradient id="orbitLine" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#7048e8" />
                  <stop offset="1" stop-color="#11b5a4" />
                </linearGradient>
                <filter id="glow">
                  <feGaussianBlur stdDeviation="4" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>
              <circle class="orbit orbit-one" cx="260" cy="260" r="178" />
              <circle class="orbit orbit-two" cx="260" cy="260" r="118" />
              <path class="orbit-path" d="M260 82 A178 178 0 0 1 438 260" />
              <path class="orbit-path" d="M260 438 A178 178 0 0 1 82 260" />
              <path class="connector" d="M166 167 L224 225 M355 168 L295 226 M354 354 L296 296 M166 353 L224 295" />
              <circle class="core-ring" cx="260" cy="260" r="70" />
              <circle class="core" cx="260" cy="260" r="56" />
              <g class="diagram-label">
                <text x="260" y="252">交付前</text>
                <text x="260" y="278">多一次確認</text>
              </g>
              <g class="node node-build" filter="url(#glow)">
                <circle cx="150" cy="150" r="27" />
                <text x="150" y="156">做</text>
              </g>
              <g class="node node-check" filter="url(#glow)">
                <circle cx="370" cy="150" r="27" />
                <text x="370" y="156">查</text>
              </g>
              <g class="node node-fix" filter="url(#glow)">
                <circle cx="370" cy="370" r="27" />
                <text x="370" y="376">修</text>
              </g>
              <g class="node node-stop" filter="url(#glow)">
                <circle cx="150" cy="370" r="27" />
                <text x="150" y="376">停</text>
              </g>
            </svg>
          </div>
          <figcaption id="hero-console-caption">
            一個可靠的流程，不是一直重做；而是每次都知道下一步該查什麼、何時該停下來。
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="friction-section">
      <div class="container friction-grid">
        <div class="section-intro">
          <p class="signal-label">THE FRICTION</p>
          <h2>真正消耗你的，<br />是最後的人工追問。</h2>
        </div>
        <div class="friction-copy">
          <p>
            AI 可以很快交出一版文章、表格或程式；但你往往接著要問數字對不對、前後是否矛盾、測試是否真的通過。這份「追問清單」若只存在腦中，每一件工作都得重新做一次。
          </p>
          <p>
            更好的做法不是要求 AI 更努力，而是先把驗收工作拆開：哪些能直接量測、哪些需要閱讀判斷、哪些一定要由人放行。
          </p>
        </div>
        <div class="friction-meter" aria-label="人工確認負擔示意">
          <div class="meter-heading"><span>人工確認負擔</span><strong>100%</strong></div>
          <div class="meter-track"><span></span></div>
          <div class="meter-note">沒有明確標準時，所有檢查都回到你身上。</div>
        </div>
      </div>
    </section>

    <section class="control-section" id="control-room">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="signal-label">CONTROL ROOM</p>
            <h2>一個交付，四個明確動作。</h2>
          </div>
          <p>點選每個節點，看看它在解決哪一種常見卡關。</p>
        </div>

        <div class="quality-console" data-quality-console>
          <div class="stage-list" role="group" aria-label="品質迴圈階段">
            <button class="stage-button is-active" type="button" data-stage-button="frame" aria-pressed="true">
              <span>01</span> 先框定
            </button>
            <button class="stage-button" type="button" data-stage-button="check" aria-pressed="false">
              <span>02</span> 再檢查
            </button>
            <button class="stage-button" type="button" data-stage-button="repair" aria-pressed="false">
              <span>03</span> 小範圍修補
            </button>
            <button class="stage-button" type="button" data-stage-button="release" aria-pressed="false">
              <span>04</span> 放行或交接
            </button>
          </div>
          <div class="stage-view">
            <p class="stage-kicker" data-stage-kicker>01 · FRAME THE JOB</p>
            <h3 data-stage-title>先把「完成」說成可確認的狀態。</h3>
            <p data-stage-copy>
              不只說「寫一篇好文章」，而是列出來源、字數、讀者與禁止事項。條件愈具體，後面的檢查愈不靠感覺。
            </p>
            <div class="stage-status" role="status" aria-live="polite">
              <span class="status-mark"></span>
              <span data-stage-status>現在先寫下：誰需要這份成果？怎樣才算可以交？</span>
            </div>
          </div>
          <div class="console-radar" aria-hidden="true">
            <span class="radar-line"></span>
            <span class="radar-point point-one"></span>
            <span class="radar-point point-two"></span>
            <span class="radar-point point-three"></span>
            <span class="radar-caption">CHECKLIST<br />READY</span>
          </div>
        </div>
      </div>
    </section>

    <section class="layers-section">
      <div class="container">
        <div class="section-heading compact">
          <div>
            <p class="signal-label">THREE LENSES</p>
            <h2>別讓一個回答，自己替自己打分數。</h2>
          </div>
          <p>把不同類型的確認，交給最合適的方式。</p>
        </div>

        <div class="lens-grid">
          <article class="lens-card machine">
            <div class="lens-index">A</div>
            <svg viewBox="0 0 96 96" aria-hidden="true">
              <path d="M22 48 40 66 75 29" />
              <circle cx="48" cy="48" r="36" />
            </svg>
            <h3>能量測的，交給規則</h3>
            <p>測試是否通過、檔案是否存在、字數是否超標，這些不要靠「看起來沒問題」。</p>
            <ul><li>測試結果</li><li>格式檢查</li><li>欄位與檔案</li></ul>
          </article>
          <article class="lens-card review">
            <div class="lens-index">B</div>
            <svg viewBox="0 0 96 96" aria-hidden="true">
              <path d="M21 62c9-24 22-36 38-36 8 0 13 4 16 10" />
              <path d="m56 69 17-17 8 8-17 17-14 4z" />
            </svg>
            <h3>需要判讀的，換一個視角</h3>
            <p>邏輯、重複、可讀性與來源對照，適合用獨立檢查者或另一輪審閱處理。</p>
            <ul><li>來源一致</li><li>脈絡合理</li><li>讀者看得懂</li></ul>
          </article>
          <article class="lens-card release">
            <div class="lens-index">C</div>
            <svg viewBox="0 0 96 96" aria-hidden="true">
              <path d="M48 15 74 25v20c0 19-11 30-26 37-15-7-26-18-26-37V25z" />
              <path d="m35 47 9 9 18-19" />
            </svg>
            <h3>真正要承擔後果的，才交給人</h3>
            <p>公開發布、付款、刪除資料與重要對外聯繫，應保留核准點，而非自動放行。</p>
            <ul><li>風險升級</li><li>例外處理</li><li>最終決策</li></ul>
          </article>
        </div>
      </div>
    </section>

    <section class="risk-section">
      <div class="container risk-layout">
        <div class="risk-copy">
          <p class="signal-label">HUMAN HANDOFF</p>
          <h2>不是把人移出流程，<br />而是把人放回正確位置。</h2>
          <p>
            自動化最有價值的地方，是替你處理可重複驗證的細節；真正需要經驗、責任與判斷的地方，則應該留下明確的人類交接點。
          </p>
        </div>
        <div class="risk-board" aria-label="風險與人工確認程度">
          <div class="risk-row low">
            <span class="risk-level">低風險</span>
            <strong>自動完成</strong>
            <p>錯字、格式、局部測試</p>
          </div>
          <div class="risk-row medium">
            <span class="risk-level">中風險</span>
            <strong>人工看最後一眼</strong>
            <p>文章、提案、競品整理</p>
          </div>
          <div class="risk-row high">
            <span class="risk-level">高風險</span>
            <strong>先核准，再執行</strong>
            <p>發布、付款、刪除、外部通知</p>
          </div>
        </div>
      </div>
    </section>

    <section class="starter-section" id="starter-kit">
      <div class="container starter-grid">
        <div>
          <p class="signal-label">START SMALL</p>
          <h2>今天就能開始的<br />一張工作指令卡。</h2>
          <p>
            不需要先建立複雜系統。先挑一個每週重複發生、又總要你複查的任務，將完成條件與停止條件寫清楚。
          </p>
          <ol class="starter-steps">
            <li><span>1</span> 選一份低風險成果。</li>
            <li><span>2</span> 寫下可驗證的完成條件。</li>
            <li><span>3</span> 限制修正次數，留下交接出口。</li>
          </ol>
        </div>
        <div class="prompt-card">
          <div class="prompt-card-top">
            <span>READY-TO-ADAPT</span>
            <button class="copy-button" type="button" data-copy-template>複製文字</button>
          </div>
          <pre data-starter-template><code>{starterPrompt}</code></pre>
          <p class="copy-status" data-copy-status role="status" aria-live="polite">可依你的工具、任務與風險調整。</p>
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-card">
        <p class="signal-label">ONE LAST CHECK</p>
        <h2>好的 AI 協作，不是多跑幾輪。<br />而是每一輪都有理由。</h2>
        <p>
          當成果、檢查、修補與放行被拆開後，AI 才能從一次性的回答工具，慢慢變成可靠的工作夥伴。人類不必盯著每一個細節，但仍握有最重要的判斷。
        </p>
        <a class="workflow-button primary" href="/insights">繼續閱讀 Simon Synapse 文章</a>
      </div>
    </section>

    <footer class="workflow-sources container">
      <div>
        <p class="signal-label">SOURCE TRAIL</p>
        <h2>閱讀與查核線索</h2>
      </div>
      <ul>
        <li><a href="https://x.com/aitech_komoriya/status/2088118607343743055" target="_blank" rel="noreferrer">閱讀原始貼文</a></li>
        <li><a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noreferrer">Anthropic：Building effective agents</a></li>
        <li><a href="https://www.anthropic.com/engineering/demystifying-evals-for-ai-agents" target="_blank" rel="noreferrer">Anthropic：Demystifying evals for AI agents</a></li>
      </ul>
      <p class="disclosure">作者：{SITE.author}　·　發布：{publishedLabel}　·　AI 協作揭露：本頁由 AI 協助整理與設計，內容經人工編修後發布。</p>
    </footer>
  </article>
</BaseLayout>

<script>
  const stages = {
    frame: {
      kicker: "01 · FRAME THE JOB",
      title: "先把「完成」說成可確認的狀態。",
      copy: "不只說「寫一篇好文章」，而是列出來源、字數、讀者與禁止事項。條件愈具體，後面的檢查愈不靠感覺。",
      status: "現在先寫下：誰需要這份成果？怎樣才算可以交？",
    },
    check: {
      kicker: "02 · CHECK THE EVIDENCE",
      title: "把可驗證的事情，交給可驗證的檢查。",
      copy: "數字是否有來源、程式是否通過測試、檔案是否存在，都應留下可回查的結果，而不是只接受一句「我確認過了」。",
      status: "現在要問：這一項有沒有能回看的依據？",
    },
    repair: {
      kicker: "03 · REPAIR THE SIGNAL",
      title: "只修問題點，不把正常部分一起推倒。",
      copy: "重新生成整份成果看似快速，卻常讓原本正確的地方失效。將修正範圍縮小，才能減少新的意外。",
      status: "現在要做：把最新問題，精準交回負責修正的人。",
    },
    release: {
      kicker: "04 · RELEASE OR HAND OFF",
      title: "通過才放行；卡住就交接，不無限重跑。",
      copy: "設定修正次數與升級條件。碰到來源不足、條件衝突或高風險行為時，清楚地把問題交回人類。",
      status: "最後確認：可以放行，還是需要一個人作決定？",
    },
  };

  const stageButtons = Array.from(document.querySelectorAll("[data-stage-button]"));
  const stageKicker = document.querySelector("[data-stage-kicker]");
  const stageTitle = document.querySelector("[data-stage-title]");
  const stageCopy = document.querySelector("[data-stage-copy]");
  const stageStatus = document.querySelector("[data-stage-status]");

  stageButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const key = button.getAttribute("data-stage-button");
      if (!key || !(key in stages)) return;
      const stage = stages[key as keyof typeof stages];

      stageButtons.forEach((candidate) => {
        const isActive = candidate === button;
        candidate.classList.toggle("is-active", isActive);
        candidate.setAttribute("aria-pressed", String(isActive));
      });
      if (stageKicker) stageKicker.textContent = stage.kicker;
      if (stageTitle) stageTitle.textContent = stage.title;
      if (stageCopy) stageCopy.textContent = stage.copy;
      if (stageStatus) stageStatus.textContent = stage.status;
    });
  });

  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-template]");
  const template = document.querySelector<HTMLElement>("[data-starter-template]");
  const copyStatus = document.querySelector("[data-copy-status]");

  copyButton?.addEventListener("click", async () => {
    const text = template?.textContent?.trim();
    if (!text || !navigator.clipboard) {
      if (copyStatus) copyStatus.textContent = "你的瀏覽器不支援自動複製，請直接選取文字。";
      return;
    }

    try {
      await navigator.clipboard.writeText(text);
      if (copyStatus) copyStatus.textContent = "已複製，可直接貼到你的工作工具中調整。";
    } catch {
      if (copyStatus) copyStatus.textContent = "無法自動複製，請直接選取文字。";
    }
  });
</script>

<style>
  :global(body.workflow-light) {
    --bg: #f4f7fb;
    --surface: #ffffff;
    --surface-raised: #ffffff;
    --surface-glass: rgb(255 255 255 / 84%);
    --border: rgb(15 32 66 / 14%);
    --border-strong: rgb(65 88 162 / 42%);
    --text: #10213e;
    --text-muted: #52627c;
    --cyan: #1368a8;
    --cyan-strong: #0b4d88;
    --violet: #5d3ec7;
    --magenta: #bd367f;
    --focus: #d77400;
    --shadow-glow: 0 1.25rem 3.5rem rgb(33 60 113 / 9%);
    color-scheme: light;
    background: #f4f7fb;
    color: var(--text);
  }

  :global(body.workflow-light::before) {
    z-index: 0;
    background-image:
      linear-gradient(rgb(22 68 129 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(22 68 129 / 4%) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: linear-gradient(to bottom, black 10%, transparent 72%);
  }

  :global(body.workflow-light .site-header) {
    border-bottom-color: rgb(21 48 93 / 10%);
    background: rgb(248 250 254 / 88%);
    box-shadow: 0 0.6rem 1.5rem rgb(26 51 94 / 6%);
  }

  :global(body.workflow-light .site-header .brand),
  :global(body.workflow-light .site-header summary),
  :global(body.workflow-light .site-header nav a) {
    color: #142544;
  }

  :global(body.workflow-light .site-header nav) {
    background: rgb(255 255 255 / 98%);
    box-shadow: 0 1rem 2rem rgb(28 50 88 / 14%);
  }

  :global(body.workflow-light .site-header .brand svg) {
    filter: drop-shadow(0 0 0.6rem rgb(77 110 198 / 24%));
  }

  :global(body.workflow-light .site-footer) {
    border-top-color: rgb(21 48 93 / 12%);
    background: #edf2fa;
  }

  :global(body.workflow-light .site-footer),
  :global(body.workflow-light .site-footer a) {
    color: #43526b;
  }

  .workflow-page {
    overflow: hidden;
    color: #10213e;
    background:
      radial-gradient(circle at 72% 7%, rgb(113 87 222 / 13%), transparent 27rem),
      radial-gradient(circle at 8% 22%, rgb(0 166 153 / 10%), transparent 26rem),
      #f4f7fb;
  }

  .workflow-page :focus-visible {
    outline: 0.2rem solid #d77400;
    outline-offset: 0.22rem;
  }

  .workflow-hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(4.5rem, 10vw, 9rem);
  }

  .workflow-hero::after {
    position: absolute;
    z-index: 0;
    right: -16rem;
    bottom: -19rem;
    width: 42rem;
    height: 42rem;
    border: 1px solid rgb(79 65 190 / 11%);
    border-radius: 50%;
    box-shadow: 0 0 0 5rem rgb(79 65 190 / 3%), 0 0 0 10rem rgb(79 65 190 / 2%);
    content: "";
    pointer-events: none;
  }

  .hero-grid,
  .friction-grid,
  .risk-layout,
  .starter-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .signal-label {
    margin-block: 0 0.9rem;
    color: #6654c8;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  h1 {
    max-width: 12ch;
    margin-block-end: 1.2rem;
    color: #10213e;
    font-size: clamp(3rem, 6.4vw, 6.5rem);
    letter-spacing: -0.065em;
  }

  h2 {
    color: #10213e;
    letter-spacing: -0.045em;
  }

  .hero-lead,
  .section-heading > p,
  .friction-copy,
