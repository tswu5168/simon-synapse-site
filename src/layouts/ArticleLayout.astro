---
import type { CollectionEntry } from "astro:content";
import AdSlot from "../components/AdSlot.astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import ExternalLink from "../components/ExternalLink.astro";
import SourceList from "../components/SourceList.astro";
import { isAdEligible, SITE } from "../config/site";
import {
  articleJsonLd,
  creativeWorkJsonLd,
} from "../lib/seo";
import BaseLayout from "./BaseLayout.astro";

type ContentEntry =
  | CollectionEntry<"insights">
  | CollectionEntry<"projects">;

interface Props {
  entry: ContentEntry;
  kind: "insight" | "project";
  pathname: string;
}

const { entry, kind, pathname } = Astro.props;
const projectData =
  kind === "project" && "projectUrl" in entry.data ? entry.data : undefined;
const parentPath = kind === "insight" ? "/insights" : "/projects";
const parentLabel = kind === "insight" ? "觀點與教學" : "作品案例";
const adsEligible = isAdEligible(pathname);
const inlineSlot = import.meta.env.PUBLIC_AD_SLOT_INLINE ?? "";
const endSlot = import.meta.env.PUBLIC_AD_SLOT_END ?? "";
const jsonLd = projectData
  ? creativeWorkJsonLd({
      title: entry.data.title,
      description: entry.data.seoDescription,
      pathname,
      publishedAt: entry.data.publishedAt,
      updatedAt: entry.data.updatedAt,
      image: entry.data.socialImage,
      projectUrl: projectData.projectUrl,
    })
  : articleJsonLd({
      title: entry.data.title,
      description: entry.data.seoDescription,
      pathname,
      publishedAt: entry.data.publishedAt,
      updatedAt: entry.data.updatedAt,
      image: entry.data.socialImage,
    });
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.seoDescription}
  canonicalPath={pathname}
  image={entry.data.socialImage}
  jsonLd={jsonLd}
  loadAds={adsEligible}
>
  <article class="article-shell container">
    <nav class="breadcrumbs" aria-label="麵包屑">
      <ol>
        <li><a href="/">首頁</a></li>
        <li><a href={parentPath}>{parentLabel}</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <header class="article-header reading-column">
      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <ul class="tag-list" aria-label="內容標籤">
        {entry.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      {projectData && <p class="project-status">狀態：{projectData.status}</p>}
      {
        projectData && (
          <p>
            <ExternalLink class="button" href={projectData.projectUrl}>
              開啟實際作品
            </ExternalLink>
          </p>
        )
      }
      <ArticleMeta
        author={entry.data.author}
        publishedAt={entry.data.publishedAt}
        updatedAt={entry.data.updatedAt}
        aiAssisted={entry.data.aiAssisted}
      />
    </header>

    <AdSlot slot={inlineSlot} pathname={pathname} />

    <div class="article-body reading-column">
      <slot />
    </div>

    <SourceList sources={entry.data.sources} />
    <AdSlot slot={endSlot} pathname={pathname} />

    <aside class="disclaimer reading-column" aria-label="固定聲明">
      <strong>內容聲明</strong>
      <p>{SITE.disclaimer}</p>
    </aside>
  </article>
</BaseLayout>

<style>
  .article-shell {
    padding-block: 2rem 5rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.85em;
  }

  .breadcrumbs li:not(:last-child)::after {
    margin-inline-start: 0.75rem;
    color: var(--violet);
    content: "/";
  }

  .article-header {
    padding-block: clamp(2rem, 7vw, 5rem) 1rem;
  }

  .lead {
    color: var(--text-muted);
    font-size: 1.08em;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    color: var(--text-muted);
    font-size: 0.8em;
  }

  .project-status {
    margin-block: var(--space-3);
    color: var(--cyan-strong);
    font-weight: 800;
  }

  .article-body {
    font-size: 1.02em;
  }

  :global(.article-body h2) {
    margin-block-start: 2.5rem;
    font-size: calc(1.75rem * var(--font-scale));
  }

  :global(.article-body h3) {
    margin-block-start: 2rem;
    font-size: calc(1.35rem * var(--font-scale));
  }

  :global(.article-body pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem;
    background: #02040c;
  }

  :global(.article-body code) {
    font-size: 0.88em;
  }

  .disclaimer {
    margin-block-start: 3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    color: var(--text-muted);
    background: var(--surface-glass);
  }

  .disclaimer strong {
    color: var(--text);
  }

  .disclaimer p {
    margin-block-end: 0;
  }
</style>
