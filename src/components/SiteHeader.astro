---
import { SITE } from "../config/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 首頁`}>
      <svg aria-hidden="true" viewBox="0 0 44 44" width="44" height="44">
        <defs>
          <linearGradient id="synapse-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#58e6ff"></stop>
            <stop offset="0.5" stop-color="#9b7bff"></stop>
            <stop offset="1" stop-color="#ff5fd2"></stop>
          </linearGradient>
        </defs>
        <circle cx="22" cy="22" r="18" fill="none" stroke="url(#synapse-gradient)" stroke-width="2"></circle>
        <circle cx="14" cy="17" r="2.7" fill="#58e6ff"></circle>
        <circle cx="29" cy="14" r="2.7" fill="#9b7bff"></circle>
        <circle cx="30" cy="29" r="2.7" fill="#ff5fd2"></circle>
        <circle cx="16" cy="30" r="2.7" fill="#58e6ff"></circle>
        <path d="m16 18 11-3M29 17l1 9M28 29l-9 1M16 27l-1-7M17 19l10 8" stroke="#dcecff" stroke-width="1.7"></path>
      </svg>
      <span>{SITE.name}</span>
    </a>

    <div class="header-actions">
      <details class="nav-menu">
        <summary aria-label="開啟網站選單">選單</summary>
        <nav aria-label="主要導覽">
          <a href="/insights">文章</a>
          <a href="/projects">作品</a>
          <a href="/about">關於</a>
          <a href="/contact">聯絡</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--border);
    background: rgb(5 8 22 / 88%);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
    backdrop-filter: blur(1rem);
  }

  .header-inner,
  .header-actions,
  .brand {
    display: flex;
    align-items: center;
  }

  .header-inner {
    min-height: var(--header-height);
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.65rem;
  }

  .brand {
    min-height: 3rem;
    gap: 0.65rem;
    color: var(--text);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
  }

  .brand svg {
    flex: 0 0 2.75rem;
    filter: drop-shadow(0 0 0.6rem rgb(88 230 255 / 35%));
  }

  .header-actions {
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .nav-menu {
    position: relative;
  }

  summary {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    color: var(--text);
    background: var(--surface-glass);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: rgb(11 16 32 / 98%);
    box-shadow: var(--shadow-glow), 0 1rem 2rem rgb(0 0 0 / 45%);
  }

  nav a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.75rem;
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--cyan-strong);
    background: rgb(88 230 255 / 8%);
  }

  @media (max-width: 39.99rem) {
    .brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }

  @media (min-width: 64rem) {
    .nav-menu summary {
      position: absolute;
      width: 1px;
      height: 1px;
      min-width: 0;
      min-height: 0;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .nav-menu nav {
      position: static;
      display: flex;
      width: auto;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
    }
  }
</style>
