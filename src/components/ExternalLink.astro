---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener noreferrer">
  <slot />
  <svg
    class="external-icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <path d="M14 5h5v5"></path>
    <path d="M10 14 19 5"></path>
    <path d="M19 13v6H5V5h6"></path>
  </svg>
  <span class="sr-only">（另開新視窗）</span>
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .external-icon {
    flex: 0 0 auto;
  }
</style>
