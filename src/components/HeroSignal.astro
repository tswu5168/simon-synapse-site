---
import { SITE } from "../config/site";
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="signal-orbit" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="hero-copy">
    <p class="eyebrow">{SITE.name} · Human ideas × AI systems</p>
    <h1 id="hero-title">{SITE.tagline}</h1>
    <p class="description">
      賽腦耶把個人發想轉化為可以驗證、持續改進與長期累積的 AI 內容和數位作品。
    </p>
    <div class="actions" aria-label="內容入口">
      <a class="button primary" href="/insights">探索文章</a>
      <a class="button" href="/projects">查看作品</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(48rem, calc(100dvh - var(--header-height)));
    padding-block: clamp(4rem, 11vw, 9rem);
    isolation: isolate;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset: 9% 0 8% 22%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 35%, rgb(88 230 255 / 24%), transparent 25%),
      radial-gradient(circle at 65% 45%, rgb(155 123 255 / 22%), transparent 34%),
      radial-gradient(circle at 50% 70%, rgb(255 95 210 / 16%), transparent 30%);
    filter: blur(2.8rem);
    content: "";
  }

  .hero-copy {
    max-width: 58rem;
  }

  h1 {
    margin-block-end: 0.35em;
    color: transparent;
    background: linear-gradient(105deg, #f4f7ff 8%, #58e6ff 45%, #b99fff 72%, #ff9ce4);
    background-clip: text;
    -webkit-background-clip: text;
    filter: drop-shadow(0 0 1.5rem rgb(88 230 255 / 18%));
  }

  .description {
    max-width: 43rem;
    color: var(--text-muted);
    font-size: 1.08em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  .primary {
    border-color: var(--cyan);
    color: #031017;
    background: linear-gradient(105deg, var(--cyan), #8ca4ff);
    font-weight: 800;
  }

  .primary:hover {
    color: #031017;
    background: linear-gradient(105deg, #9ef2ff, #b7c2ff);
  }

  .signal-orbit {
    position: absolute;
    z-index: -1;
    top: 12%;
    right: 2%;
    width: min(42vw, 24rem);
    aspect-ratio: 1;
    border: 1px solid rgb(88 230 255 / 22%);
    border-radius: 50%;
    box-shadow:
      inset 0 0 3rem rgb(88 230 255 / 7%),
      0 0 3rem rgb(155 123 255 / 9%);
  }

  .signal-orbit::before,
  .signal-orbit::after {
    position: absolute;
    inset: 18%;
    border: 1px solid rgb(155 123 255 / 30%);
    border-radius: 50%;
    content: "";
    transform: rotate(42deg) scaleY(0.45);
  }

  .signal-orbit::after {
    inset: 28%;
    border-color: rgb(255 95 210 / 34%);
    transform: rotate(-24deg) scaleX(0.55);
  }

  .signal-orbit span {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 1rem var(--cyan);
  }

  .signal-orbit span:nth-child(1) {
    top: 18%;
    left: 16%;
  }

  .signal-orbit span:nth-child(2) {
    top: 46%;
    right: 4%;
    background: var(--violet);
    box-shadow: 0 0 1rem var(--violet);
  }

  .signal-orbit span:nth-child(3) {
    right: 30%;
    bottom: 6%;
    background: var(--magenta);
    box-shadow: 0 0 1rem var(--magenta);
  }

  @media (max-width: 47.99rem) {
    .signal-orbit {
      top: 6%;
      right: 0;
      width: 17rem;
      opacity: 0.58;
    }
  }
</style>
